# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your-azure-api-key-here
AZURE_API_VERSION=2024-02-15-preview

# Azure Deployment Names (replace with your actual deployment names)
AZURE_GPT4_MINI_DEPLOYMENT=gpt-4-mini
AZURE_O3_MINI_DEPLOYMENT=o3-mini

# Optional: OpenAI Configuration (for fallback or comparison)
OPENAI_KEY=your-openai-api-key-here

# Optional: HuggingFace (for model/dataset retrieval)
HF_KEY=your-huggingface-token-here

# Optional: PapersWithCode (for research insights)
PWC_KEY=your-paperswithcode-key-here

# Optional: Search APIs (for knowledge retrieval)
SEARCHAPI_API_KEY=your-searchapi-key-here
TAVILY_API_KEY=your-tavily-api-key-here

# Optional: Kaggle (for dataset/notebook retrieval)
# Place your kaggle.json in ~/.kaggle/kaggle.json instead
# KAGGLE_USERNAME=your-kaggle-username
# KAGGLE_KEY=your-kaggle-key
